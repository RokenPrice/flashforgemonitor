        self.colour.setFixedSize(
            28,
            28,
        )

        self.name = QLabel(
            f"T{slot}"
        )
        self.name.setObjectName(
            "materialName"
        )

        self.active_label = QLabel(
            ""
        )
        self.active_label.setObjectName(
            "activeLabel"
        )

        self.temperature = QLabel(
            "-- / --°C"
        )
        self.temperature.setAlignment(
            Qt.AlignRight
            | Qt.AlignVCenter
        )

        layout.addWidget(
            self.colour
        )
        layout.addWidget(
            self.name
        )
        layout.addStretch()
        layout.addWidget(
            self.active_label
        )
        layout.addWidget(
            self.temperature
        )

        self.set_material(
            "#444444",
            "Unknown",
            False,
            False,
        )

    def set_material(
        self,
        colour,
        name,
        has_filament,
        active,
    ):
        colour = colour or "#444444"

        if not QColor(colour).isValid():
            colour = "#444444"

        self.colour.setStyleSheet(
            f"""
            background-color: {colour};
            border-radius: 14px;
            border: 2px solid #777;
            """
        )

        filament_state = (
            ""
            if has_filament
            else "  • EMPTY"
        )

        self.name.setText(
            f"T{self.slot}   "
            f"{name}"
            f"{filament_state}"
        )

        self.active_label.setText(
            "ACTIVE" if active else ""
        )

    def set_offline(self):
        self.colour.setStyleSheet(
            """
            background-color: #444444;
            border-radius: 14px;
            border: 2px solid #777;
            """
        )

        self.name.setText(
            f"T{self.slot}   OFFLINE"
        )

        self.active_label.setText(
            ""
        )

        self.temperature.setText(
            "-- / --°C"
        )

    def set_temperature(
        self,
        actual,
        target,
    ):
        self.temperature.setText(
            temp_text(
                actual,
                target,
            )
        )


