def load_config(config_file):
    with config_file.open("r", encoding="utf-8") as f:
        return json.load(f)


def format_duration(seconds):
    try:
        seconds = int(seconds)
    except (TypeError, ValueError):
        return "--:--"

    hours, remainder = divmod(seconds, 3600)
    minutes, secs = divmod(remainder, 60)

    if hours:
        return f"{hours}:{minutes:02d}:{secs:02d}"

    return f"{minutes:02d}:{secs:02d}"


def temp_text(actual, target):
    try:
        actual = int(round(float(actual)))
    except (TypeError, ValueError):
        actual = 0

    try:
        target = int(round(float(target)))
    except (TypeError, ValueError):
        target = 0

    if target <= 0:
        return f"{actual}°C"

    return f"{actual} / {target}°C"


class DetailWorker(QObject):
    result = Signal(dict)
    error = Signal(str)
    finished = Signal()

    def __init__(self, config):
        super().__init__()
        self.config = config

    def fetch(self):
        try:
            payload = json.dumps(
                {
                    "serialNumber": self.config["serial"],
                    "checkCode": self.config["access_code"],
                }
            ).encode("utf-8")

            request = urllib.request.Request(
                f"http://{self.config['ip']}:8898/detail",
                data=payload,
                headers={
                    "Content-Type": "application/json"
                },
                method="POST",
            )

            with urllib.request.urlopen(
                request,
                timeout=2,
            ) as response:
                data = json.loads(
                    response.read().decode("utf-8")
                )

            if data.get("code") != 0:
                raise RuntimeError(
                    data.get(
                        "message",
                        "Printer API error",
                    )
                )

            detail = data.get("detail")

            if not isinstance(detail, dict):
                raise RuntimeError(
                    "Printer response contained no detail object"
                )
            self.result.emit(detail)

        except Exception as exc:
            self.error.emit(str(exc))

        finally:
            self.finished.emit()


class ControlWorker(QObject):
    error = Signal(str)
    finished = Signal()

    def __init__(
        self,
        config,
        action,
        command="jobCtl_cmd",
    ):
        super().__init__()
        self.config = config
        self.action = action
        self.command = command

    def send(self):
        try:
            payload = json.dumps(
                {
                    "serialNumber": self.config["serial"],
                    "checkCode": self.config["access_code"],
                    "payload": {
                        "cmd": self.command,
                        "args": {
                            "action": self.action,
                        },
                    },
                }
            ).encode("utf-8")

            request = urllib.request.Request(
                f"http://{self.config['ip']}:8898/control",
                data=payload,
                headers={
                    "Content-Type": "application/json"
                },
                method="POST",
            )

            with urllib.request.urlopen(
                request,
                timeout=2,
            ) as response:
                data = json.loads(
                    response.read().decode("utf-8")
                )

            if data.get("code") != 0:
                raise RuntimeError(
                    data.get(
                        "message",
                        "Printer control error",
                    )
                )

        except Exception as exc:
            self.error.emit(str(exc))

        finally:
            self.finished.emit()


class MaterialWidget(QFrame):
