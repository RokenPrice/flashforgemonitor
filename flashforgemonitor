    def pause_or_resume(self):
        if self.control_running:
            return

        if self.last_status == "PAUSE":
            self.send_job_control(
                "continue"
            )
        elif self.last_status == "PRINTING":
            self.send_job_control(
                "pause"
            )

    def cancel_current_print(self):
        if (
            self.control_running
            or self.last_status not in (
                "PRINTING",
                "PAUSE",
            )
        ):
            return

        answer = QMessageBox.question(
            self,
            APP_NAME,
            "Cancel the current print?",
            QMessageBox.Yes
            | QMessageBox.No,
            QMessageBox.No,
        )

        if answer == QMessageBox.Yes:
            self.auto_clear_after_cancel = (
                not self.actual_print_started
            )
            self.auto_clear_sent = False

            self.send_job_control(
                "cancel"
            )

    def send_job_control(
        self,
        action,
        command="jobCtl_cmd",
    ):
        if self.control_running:
            return

        self.control_running = True
        self.update_control_buttons(
            self.last_status
        )

        self.control_thread = QThread(
            self
        )
        self.control_worker = ControlWorker(
            self.config,
            action,
            command,
        )

        self.control_worker.moveToThread(
            self.control_thread
        )

        self.control_thread.started.connect(
            self.control_worker.send
        )

        self.control_worker.error.connect(
            self.show_control_error
        )

        self.control_worker.finished.connect(
            self.control_thread.quit
        )
        self.control_worker.finished.connect(
            self.control_worker.deleteLater
        )
        self.control_thread.finished.connect(
            self.control_thread.deleteLater
        )
        self.control_thread.finished.connect(
            self.control_finished
        )

        self.control_thread.start()

    def control_finished(self):
        self.control_running = False
        self.update_control_buttons(
            self.last_status
        )

        # The command response only acknowledges receipt.
        # /detail remains the source of truth.
        if not self.request_running:
            self.request_update()

    def show_control_error(
        self,
        message,
    ):
        QMessageBox.warning(
            self,
            APP_NAME,
            "Printer control failed:\n"
            + message,
        )

    def update_control_buttons(
        self,
        status,
    ):
        if (
            self.control_running
            or self.is_offline
        ):
            self.pause_resume.setEnabled(
                False
            )
            self.cancel_print.setEnabled(
                False
            )
            return

        if status == "PRINTING":
            self.pause_resume.setText(
                "PAUSE"
            )
            self.pause_resume.setEnabled(
                True
            )
            self.cancel_print.setEnabled(
                True
            )
        elif status == "PAUSE":
            self.pause_resume.setText(
                "RESUME"
            )
            self.pause_resume.setEnabled(
                True
            )
            self.cancel_print.setEnabled(
                True
            )
        else:
            self.pause_resume.setText(
                "PAUSE"
            )
            self.pause_resume.setEnabled(
                False
            )
            self.cancel_print.setEnabled(
                False
            )

    def request_update(self):
        if not self.config:
            return

        if self.request_running:
            return

        self.request_running = True

        self.thread = QThread(
            self
        )

        self.worker = DetailWorker(
            self.config
        )

        self.worker.moveToThread(
            self.thread
        )

        self.thread.started.connect(
            self.worker.fetch
        )

        self.worker.result.connect(
            self.update_display
        )

        self.worker.error.connect(
            self.show_error
        )

        self.worker.finished.connect(
            self.thread.quit
        )

        self.worker.finished.connect(
            self.worker.deleteLater
        )

        self.thread.finished.connect(
            self.thread.deleteLater
        )

        self.thread.finished.connect(
            self.request_finished
        )

        self.thread.start()

    def request_finished(self):
        self.request_running = False

    def show_error(
        self,
        message,
    ):
        if not self.is_offline:
            self.is_offline = True
            self.stop_camera()
            self.camera_widget.hide()
            self.camera_offline.show()

            for widget in self.materials:
                widget.set_offline()

        self.connection.setText(
            "OFFLINE"
        )

        self.update_control_buttons(
            "OFFLINE"
        )

        self.connection.setToolTip(
            message
        )

        if self.timer.interval() != self.offline_interval:
            self.timer.setInterval(
                self.offline_interval
            )

    def set_printer_artwork(
        self,
        model_name,
    ):
        key = str(model_name).strip().lower()
        artwork = PRINTER_ARTWORK.get(key)

        if artwork and artwork.is_file():
            pixmap = QPixmap(str(artwork))
            self.printer_image.setPixmap(
                pixmap.scaled(
                    330,
                    330,
                    Qt.KeepAspectRatio,
                    Qt.SmoothTransformation,
                )
            )
            self.printer_image.setText("")
        else:
            self.printer_image.clear()
            self.printer_image.setText(
                str(model_name)
                if model_name
                else APP_NAME
            )

    def update_display(
        self,
        d,
    ):
        status = str(
            d.get(
                "status",
                "unknown",
            )
        ).upper()

        self.connection.setText(
            status
        )

        self.connection.setToolTip(
            ""
        )

        if status == "READY":
            self.original_estimate = None
            self.remaining_estimate = None
            self.actual_print_started = False
            self.auto_clear_after_cancel = False
            self.auto_clear_sent = False

        self.update_control_buttons(
            status
        )

        model = d.get("model")
        if model:
            model_name = str(model)
            self.title.setText(
                model_name.upper()
            )
            self.setWindowTitle(
                model_name
            )
            self.set_printer_artwork(
                model_name
            )

        if self.is_offline:
            self.is_offline = False
            self.camera_offline.hide()
            self.camera_widget.show()
            self.start_camera()

        if self.timer.interval() != self.online_interval:
            self.timer.setInterval(
                self.online_interval
            )

        filename = (
            d.get("printFileName")
            or d.get("printFile")
            or ""
        )

        if filename:
            self.filename.setText(
                filename
            )
        else:
            self.filename.setText(
                "No active job"
            )

        try:
            fraction = float(
                d.get(
                    "printProgress",
                    0,
                )
                or 0
            )
        except (
            TypeError,
            ValueError,
        ):
            fraction = 0

        fraction = max(
            0.0,
            min(
                1.0,
                fraction,
            ),
        )

        display_fraction = fraction

        self.progress.setValue(
            round(
                display_fraction * 1000
            )
        )

        self.progress_text.setText(
            f"{display_fraction * 100:.1f}%"
        )

        # The percentage is centred. Before the fill reaches
        # the centre it sits on the dark background; from 50%
        # onward it sits on the light progress chunk.
        if display_fraction < 0.5:
            progress_text_colour = "#e7e9ec"
        else:
            progress_text_colour = "#17191d"

        self.progress_text.setStyleSheet(
            "background: transparent; "
            f"color: {progress_text_colour}; "
            "font-weight: 600;"
        )

        current_layer = d.get(
            "printLayer",
            0,
        )

        target_layer = d.get(
            "targetPrintLayer",
            0,
        )

        self.layer.setText(
            f"Layer "
            f"{current_layer} / "
            f"{target_layer}"
        )

        self.elapsed.setText(
            "Elapsed "
            + format_duration(
                d.get(
                    "printDuration",
                    0,
                )
            )
        )

        station = (
            d.get(
                "matlStationInfo"
            )
            or {}
        )

        state_action = station.get(
            "stateAction"
        )

        if state_action == 4:
            self.actual_print_started = True
            self.auto_clear_after_cancel = False

        # Capture the printer estimate once when actual timed
        # printing begins. On the C5 Pro this is the observed
        # transition into stateAction 4.
        if (
            state_action == 4
            and self.last_state_action != 4
        ):
            try:
                self.original_estimate = int(
                    d.get(
                        "estimatedTime",
                        0,
                    )
                    or 0
                )
            except (
                TypeError,
                ValueError,
            ):
                self.original_estimate = 0

            self.remaining_estimate = (
                self.original_estimate
            )

        if (
            status == "PRINTING"
            and self.original_estimate is not None
        ):
            self.remaining_estimate = max(
                0,
                round(
                    self.original_estimate
                    * (1.0 - fraction)
                ),
            )

            self.estimated.setText(
                "Remaining "
                + format_duration(
                    self.remaining_estimate
                )
            )
        elif (
            status == "COMPLETED"
            and self.original_estimate is not None
        ):
            self.remaining_estimate = 0

            self.estimated.setText(
                "Estimated "
                + format_duration(
                    self.original_estimate
                )
            )
        else:
            self.estimated.setText(
                "Estimated "
                + format_duration(
                    d.get(
                        "estimatedTime",
                        0,
                    )
                )
            )

        if (
            status in ("CANCEL", "CANCELLED")
            and self.auto_clear_after_cancel
            and not self.actual_print_started
            and not self.auto_clear_sent
            and not self.control_running
        ):
            self.auto_clear_sent = True
            self.send_job_control(
                "setClearPlatform",
                command="stateCtrl_cmd",
            )

        self.last_state_action = state_action
        self.last_status = status

        self.bed.setText(
            "BED  "
            + temp_text(
                d.get(
                    "platTemp",
                    0,
                ),
                d.get(
                    "platTargetTemp",
                    0,
                ),
            )
        )

        self.chamber.setText(
            "CHAMBER  "
            + temp_text(
                d.get(
                    "chamberTemp",
                    0,
                ),
                d.get(
                    "chamberTargetTemp",
                    0,
                ),
            )
        )

        self.chamber_fan.setText(
            "CHAMBER FAN  "
            f"{d.get('chamberFanSpeed', 0)}"
        )

        state_action = (
            station.get(
                "stateAction",
                "?",
            )
        )

        self.state.setText(
            f"Action "
            f"{state_action}"
        )

        slots = (
            station.get(
                "slotInfos"
            )
            or []
        )

        current_slot = (
            station.get(
                "currentSlot",
                0,
            )
        )

        nozzle_temps = (
            d.get(
                "nozzleTemps"
            )
            or []
        )

        nozzle_targets = (
            d.get(
                "nozzleTargetTemps"
            )
            or []
        )

        for index, widget in enumerate(
            self.materials
        ):
            slot_number = (
                index + 1
            )

            if index < len(slots):
                info = (
                    slots[index]
                    or {}
                )

                widget.set_material(
                    info.get(
                        "materialColor",
                        "#444444",
                    ),
                    info.get(
                        "materialName",
                        "Unknown",
                    ),
                    bool(
                        info.get(
                            "hasFilament",
                            False,
                        )
                    ),
                    slot_number
                    == current_slot,
                )

            if index < len(
                nozzle_temps
            ):
                actual = (
                    nozzle_temps[index]
                )
            else:
                actual = 0

            if index < len(
                nozzle_targets
            ):
                target = (
                    nozzle_targets[index]
                )
            else:
                target = 0
            widget.set_temperature(
                actual,
                target,
            )

    def open_configuration(self):
        filename, _ = QFileDialog.getOpenFileName(
            self,
            "Open Configuration",
            str(self.config_file.parent),
            "JSON configuration (*.json);;All files (*)",
        )

        if not filename:
            return

        new_config_file = Path(filename)

        try:
            new_config = load_config(
                new_config_file
            )
            for key in (
                "ip",
                "serial",
                "access_code",
            ):
                if key not in new_config:
                    raise ValueError(
                        f"Missing configuration value: {key}"
                    )
        except Exception as exc:
            QMessageBox.warning(
                self,
                APP_NAME,
                f"Could not load configuration:\n{exc}",
            )
            return

        self.stop_camera()

        self.config_file = new_config_file
        self.config = new_config

        self.last_status = None
        self.last_state_action = None
        self.actual_print_started = False
        self.auto_clear_after_cancel = False
        self.auto_clear_sent = False
        self.original_estimate = None
        self.remaining_estimate = None
        self.is_offline = False

        self.title.setText(
            "FLASHFORGE MONITOR"
        )
        self.setWindowTitle(
            APP_NAME
        )
        self.printer_image.clear()
        self.printer_image.setText(
            APP_NAME
        )
        self.connection.setText(
            "CONNECTING"
        )
        self.connection.setToolTip(
            ""
        )

        self.camera_offline.hide()
        self.camera_widget.show()

        for widget in self.materials:
            widget.set_offline()

        self.online_interval = int(
            self.config.get(
                "poll_interval",
                2,
            )
            * 1000
        )
        self.timer.setInterval(
            self.online_interval
        )

        self.start_camera()

        if not self.request_running:
            self.request_update()

    def show_about(self):
        QMessageBox.about(
            self,
            "About Flashforge Monitor",
            (
                "<b>Flashforge Monitor</b><br><br>"
                "A lightweight Linux desktop monitor for "
                "compatible Flashforge 3D printers, providing "
                "local printer status, material information "
                "and camera monitoring.<br><br>"
                "Developed by <b>Steve Hargreaves</b>, with "
                "development assistance from "
                "<b>OpenAI ChatGPT</b>.<br><br>"
                "Open-source software."
            ),
        )

    def start_camera(self):
        if not self.config:
            return

        if (
            self.mpv
            and self.mpv.poll() is None
        ):
            return

        stream_url = (
            f"http://{self.config['ip']}:8080/"
            "?action=stream&resolution=640x480"
        )

        # Get the real X11 window ID of the native Qt
        # camera widget. mpv will render directly into it.

        window_id = int(
            self.camera_widget.winId()
        )

        command = [
            "mpv",
            "--no-audio",
            "--cache=no",
            "--demuxer-readahead-secs=0",
            "--demuxer-max-bytes=1MiB",
            "--demuxer-max-back-bytes=0",
            "--profile=low-latency",
            "--untimed",
            "--keepaspect=yes",
            "--panscan=0",
            f"--wid={window_id}",
            stream_url,
        ]

        try:
            self.mpv = (
                subprocess.Popen(
                    command
                )
            )

        except FileNotFoundError:
            print(
                "mpv not installed",
                file=sys.stderr,
            )

    def stop_camera(self):
        if (
            self.mpv
            and self.mpv.poll() is None
        ):
            self.mpv.terminate()

            try:
                self.mpv.wait(
                    timeout=1
                )

            except subprocess.TimeoutExpired:
                self.mpv.kill()

        self.mpv = None

    def closeEvent(
        self,
        event,
    ):
        self.stop_camera()
        event.accept()


def main():
    parser = argparse.ArgumentParser(
        description=APP_NAME
    )
    parser.add_argument(
        "--config",
        type=Path,
        default=DEFAULT_CONFIG_FILE,
        help=(
            "Path to printer configuration file "
            f"(default: {DEFAULT_CONFIG_FILE})"
        ),
    )
    args = parser.parse_args()

    config_file = args.config.expanduser()

    app = QApplication(
        sys.argv
    )

    app.setApplicationName(
        APP_NAME
    )

    window = Dashboard(config_file)
    window.show()

    sys.exit(
        app.exec()
    )


if __name__ == "__main__":
    main()
