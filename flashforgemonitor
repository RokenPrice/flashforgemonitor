def application_icon():
    candidates = [
        Path("/usr/share/icons/hicolor/scalable/apps") / ICON_NAME,
        ARTWORK_DIR / ICON_NAME,
        Path(__file__).resolve().with_name(ICON_NAME),
        Path.home() / ".icons" / ICON_NAME,
        Path.home() / ".icons" / "flashforgemonitor-fixed.svg",
    ]

    for candidate in candidates:
        if candidate.is_file():
            return QIcon(str(candidate))

    # Also allow the desktop's icon theme to supply it later when packaged.
    return QIcon.fromTheme("flashforgemonitor")


